<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS capture -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Phone / SIM / caller number -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Contact names for forwarded senders/callers (never forwarded itself) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background reliability -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required for ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS; without it the
         system throws SecurityException and the in-app request button silently no-ops. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".TeleRelayApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_telerelay"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeleRelay">

        <!-- Handling locale config changes here means a language change (device
             language, or a per-app override set from system settings via
             localeConfig) is delivered as a configuration update instead of an
             activity recreation — the screen recomposes in place. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Protected system broadcast: only the platform can deliver it, so
             exported=true is safe. android:permission additionally blocks any
             non-system sender from invoking this receiver directly. -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- BOOT_COMPLETED is a protected system broadcast as well. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- PHONE_STATE is a protected system broadcast too; on API 31+ it is the
             only ringing-time channel that still carries the caller number. -->
        <receiver
            android:name=".receiver.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- specialUse: a continuously-running relay that keeps the telephony
             listener alive. dataSync would be killed after 6h/day on Android 15+. -->
        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously monitors incoming call state so incoming and missed calls can be relayed to the user's own Telegram bot chat, as explicitly configured by the user." />
        </service>

        <!-- WorkManager is initialised on demand through Hilt's worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
