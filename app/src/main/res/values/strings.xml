    <!-- Permissions -->
    <string name="perm_group_sms_title">SMS</string>
    <string name="perm_group_sms_rationale">Needed to capture incoming SMS so they can be forwarded to your own Telegram chat.</string>
    <string name="perm_group_phone_title">Phone state</string>
    <string name="perm_group_phone_rationale">Needed to detect when a call is ringing and to add SIM info to messages.</string>
    <string name="perm_group_calllog_title">Call log</string>
    <string name="perm_group_calllog_rationale">On Android 12+ the system hides the caller number from call events; this permission lets TeleRelay look up the number of the current call so it can be shown. No call history is stored or forwarded.</string>
    <string name="perm_group_notifications_title">Notifications</string>
    <string name="perm_group_notifications_rationale">Needed to show the persistent notification that keeps call monitoring alive.</string>
