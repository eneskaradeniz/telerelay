<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">TeleRelay</string>

    <!-- Foreground service notification -->
    <string name="notif_channel_monitor_name">Call monitoring</string>
    <string name="notif_monitor_title">TeleRelay is running</string>
    <string name="notif_monitor_text">Incoming calls are relayed to your Telegram chat</string>

    <!-- Permissions -->
    <string name="perm_group_sms_title">SMS</string>
    <string name="perm_group_sms_rationale">Needed to capture incoming SMS so they can be forwarded to your own Telegram chat.</string>
    <string name="perm_group_phone_title">Phone state</string>
    <string name="perm_group_phone_rationale">Needed to detect when a call is ringing and to add SIM info to messages.</string>
    <string name="perm_group_calllog_title">Call log</string>
    <string name="perm_group_calllog_rationale">On Android 12+ the system hides the caller number from call events; this permission lets TeleRelay look up the number of the current call so it can be shown. No call history is stored or forwarded.</string>
    <string name="perm_group_contacts_title">Contacts</string>
    <string name="perm_group_contacts_rationale">Lets TeleRelay show the contact name instead of a raw phone number in forwarded messages. Names are looked up on the device only — nothing is stored or forwarded beyond the message itself.</string>
    <string name="perm_group_notifications_title">Notifications</string>
    <string name="perm_group_notifications_rationale">Needed to show the persistent notification that keeps call monitoring alive.</string>
    <string name="perm_action_grant">Grant</string>
    <string name="perm_all_granted">All required permissions are granted.</string>
    <string name="perm_section_title">Permissions</string>

    <!-- Credentials -->
    <string name="section_credentials">Telegram credentials</string>
    <string name="field_bot_token">Bot token (from @BotFather)</string>
    <string name="field_chat_id">Chat ID</string>
    <string name="field_token_saved">Token saved — ends in %1$s</string>
    <string name="action_toggle_token_visibility">Show or hide the token</string>
    <string name="action_test">Send test message</string>
