    <string name="test_failed_token">Delivery failed: the bot token is invalid.</string>
    <string name="test_failed_chat">Delivery failed: chat not found — check the chat ID and make sure you have sent /start to your bot.</string>
    <string name="test_not_configured">Enter a bot token and chat ID first.</string>
    <string name="test_failed_network">Delivery failed: network error. Try again later.</string>

    <!-- Forwarding toggles -->
    <string name="section_forwarding">Forwarding</string>
    <string name="toggle_sms">Forward SMS</string>
    <string name="toggle_sms_hint">Works as soon as enabled; does not need the foreground service.</string>
    <string name="toggle_calls">Incoming call notifications</string>
    <string name="toggle_calls_hint">Needs the foreground service (started automatically).</string>
    <string name="toggle_missed">Missed call notifications</string>
